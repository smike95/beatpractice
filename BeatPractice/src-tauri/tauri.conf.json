{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeatPractice",
  "version": "1.5.6",
  "identifier": "com.beatpractice.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BeatPractice",
        "width": 1600,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Ukrainian"
        ],
        "displayLanguageSelector": false,
        "template": "windows/installer.nsi",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
